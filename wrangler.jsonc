{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nimbusit",
  "compatibility_date": "2026-08-28",

  // Privremena zaštita ispred SVIH stranica i resursa.
  "main": "worker/index.mjs",
  "vars": {
    "SITE_VISIBILITY": "private"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    // Nepostojeća adresa poslužuje 404.html umjesto prazne stranice
    "not_found_handling": "404-page"
  },

  // Produkcijska domena je nimbusit.hr; bez javnog workers.dev duplikata.
  // Ova promjena konfiguracije primjenjuje se tek pri budućoj autoriziranoj objavi.
  "workers_dev": false,
  "preview_urls": false,

  "observability": { "enabled": true }
}
