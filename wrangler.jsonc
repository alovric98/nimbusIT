{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nimbusit",
  "compatibility_date": "2026-08-28",

  // Statična stranica: nema koda poslužitelja, samo datoteke.
  "assets": {
    "directory": ".",
    // Nepostojeća adresa poslužuje 404.html umjesto prazne stranice
    "not_found_handling": "404-page"
  },

  // Produkcijska domena je nimbusit.hr; bez javnog workers.dev duplikata.
  // Ova promjena konfiguracije primjenjuje se tek pri budućoj autoriziranoj objavi.
  "workers_dev": false,

  "observability": { "enabled": true }
}
