---
import type { Locale } from '../data/site';
import PageIntro from './PageIntro.astro';
import ContactCta from './ContactCta.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const de = lang === 'de';
const facts = de ? [
  ['Berufspraxis', 'Vier Jahre professionelle IT-Erfahrung und praktische Arbeit mit Infrastruktur-Automatisierung.'],
  ['Ausbildung', 'Fachliche Ausbildung in System- und Netzwerkadministration sowie Cloud-Infrastruktur.'],
  ['Kommunikation', 'Deutsch auf C1-Niveau für technische Abstimmungen und direkte Zusammenarbeit.'],
] : [
  ['Professional practice', 'Four years of professional IT experience and practical work in infrastructure automation.'],
  ['Education', 'Formal education in system and network administration and cloud infrastructure.'],
  ['Communication', 'C1 German proficiency for technical discussions and direct collaboration.'],
];
---
<PageIntro eyebrow={de ? 'ÜBER NIMBUS IT' : 'ABOUT NIMBUS IT'} title={de ? 'Ein direkter Ansprechpartner. Ein klarer technischer Fokus.' : 'One direct point of contact. A clear technical focus.'} description={de ? 'Nimbus IT ist meine unabhängige IT-Beratung aus Kroatien. Ich unterstütze Systemhäuser und Managed Service Provider im deutschsprachigen Raum bei Automatisierung und Infrastrukturprojekten.' : 'Nimbus IT is my independent IT consultancy based in Croatia. I support IT service providers and managed service providers in German-speaking markets with automation and infrastructure projects.'} />
<section class="section"><div class="container about-detail-grid"><figure class="portrait-placeholder"><div class="portrait-monogram" aria-hidden="true"><img src="/brand/symbol-on-light.svg" width="304" height="220" alt="" loading="lazy" /></div><figcaption><span class="eyebrow">{de ? 'PLATZ FÜR EIN PERSÖNLICHES PORTRÄT' : 'SPACE FOR A PERSONAL PORTRAIT'}</span><span>{de ? 'Ein authentisches Foto folgt.' : 'An authentic photograph will follow.'}</span></figcaption></figure><div class="about-story"><p class="eyebrow">{de ? 'PRAKTISCH DENKEN. SAUBER UMSETZEN.' : 'THINK PRACTICALLY. IMPLEMENT CAREFULLY.'}</p><h2>{de ? 'IT soll den Alltag erleichtern.' : 'IT should make daily work easier.'}</h2><p class="lead">{de ? 'Ich entwickle Automatisierung so, dass Ihr Team sie nachvollziehen, prüfen und weiterführen kann.' : 'I develop automation your team can understand, review and maintain.'}</p><p>{de ? 'Meine praktische Engineering-Erfahrung liegt in Infrastruktur-Automatisierung, Windows-Umgebungen und Azure-Projekten. Bei PowerShell-Skripten achte ich auf verständliche Parameter, Fehlerbehandlung und nachvollziehbare Protokolle – auch für den nächsten Betriebseinsatz.' : 'My practical engineering experience covers infrastructure automation, Windows environments and Azure projects. In PowerShell scripts, I focus on clear parameters, error handling and useful logs, including for subsequent runs in operation.'}</p><p>{de ? 'Änderungen halte ich in Git nachvollziehbar. Kleine, abgegrenzte Anpassungen erleichtern Code-Reviews mit Ihrem Team. Tests erfolgen in der vereinbarten Umgebung, bevor Änderungen für den Betrieb freigegeben werden.' : 'I track changes in Git. Small, focused changes make code review with your team easier. Testing takes place in the agreed environment before changes are approved for operational use.'}</p><p>{de ? 'Zur Übergabe gehören Voraussetzungen, Konfigurationshinweise und bekannte Grenzen. So erhält Ihr Team neben dem Skript auch die Informationen, die es für Betrieb und Pflege braucht.' : 'Handover includes prerequisites, configuration notes and known limitations. Your team receives both the script and the information needed to operate and maintain it.'}</p></div></div></section>
<section class="section experience-section"><div class="container"><p class="eyebrow">{de ? 'FACHLICHER HINTERGRUND' : 'PROFESSIONAL BACKGROUND'}</p><h2>{de ? 'Erfahrung, auf die Sie aufbauen können.' : 'Experience you can build on.'}</h2><dl class="experience-list">{facts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></div></section>
<ContactCta lang={lang} />
