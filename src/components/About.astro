---
import type { Locale } from '../data/site';
import PageIntro from './PageIntro.astro';
import ContactCta from './ContactCta.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const de = lang === 'de';
const facts = de ? [
  ['Berufspraxis', 'Vier Jahre professionelle IT-Erfahrung und praktische Arbeit mit Infrastruktur-Automatisierung.'],
  ['Ausbildung', 'Fachliche Ausbildung in System- und Netzwerkadministration sowie Cloud-Infrastruktur.'],
  ['Kommunikation', 'Deutsch auf C1-Niveau für technische Abstimmungen und direkte Zusammenarbeit.'],
] : [
  ['Professional practice', 'Four years of professional IT experience and practical work in infrastructure automation.'],
  ['Education', 'Formal education in system and network administration and cloud infrastructure.'],
  ['Communication', 'C1 German proficiency for technical discussions and direct collaboration.'],
];
---
<PageIntro eyebrow={de ? 'ÜBER NIMBUS IT' : 'ABOUT NIMBUS IT'} title={de ? 'Ein direkter Ansprechpartner. Ein klarer technischer Fokus.' : 'One direct point of contact. A clear technical focus.'} description={de ? 'Nimbus IT ist meine unabhängige IT-Beratung aus Kroatien. Ich unterstütze Systemhäuser und Managed Service Provider im deutschsprachigen Raum bei Automatisierung und Infrastrukturprojekten.' : 'Nimbus IT is my independent IT consultancy based in Croatia. I support IT service providers and managed service providers in German-speaking markets with automation and infrastructure projects.'} />
<section class="section"><div class="container about-detail-grid"><figure class="portrait-placeholder"><div class="portrait-monogram" aria-hidden="true"><svg width="96" height="96" viewBox="0 0 32 32" fill="none"><path d="M3 27V5h6l14 17V5h6v22h-6L9 10v17H3Z" fill="currentColor"/></svg></div><figcaption><span class="eyebrow">{de ? 'PLATZ FÜR EIN PERSÖNLICHES PORTRÄT' : 'SPACE FOR A PERSONAL PORTRAIT'}</span><span>{de ? 'Ein authentisches Foto folgt.' : 'An authentic photograph will follow.'}</span></figcaption></figure><div class="about-story"><p class="eyebrow">{de ? 'PRAKTISCH DENKEN. SAUBER UMSETZEN.' : 'THINK PRACTICALLY. IMPLEMENT CAREFULLY.'}</p><h2>{de ? 'IT soll den Alltag erleichtern.' : 'IT should make daily work easier.'}</h2><p class="lead">{de ? 'Mich interessiert, wie aus einzelnen manuellen Schritten ein verlässlicher, nachvollziehbarer Ablauf wird.' : 'I am interested in turning individual manual tasks into reliable, traceable workflows.'}</p><p>{de ? 'Meine Arbeit verbindet Infrastrukturwissen mit praktischer Automatisierung. Ich unterstütze bei PowerShell-Workflows, Windows-Umgebungen und Azure-Projekten – mit Blick darauf, wie Ihr Team die Lösung später betreibt und weiterentwickelt.' : 'My work combines infrastructure knowledge with practical automation. I help with PowerShell workflows, Windows environments and Azure projects, keeping in mind how your team will operate and extend the solution.'}</p><p>{de ? 'Sie arbeiten direkt mit mir. Aufgaben, Zuständigkeiten und Grenzen stimmen wir vorab ab. Bestehende Standards und die Zusammenarbeit mit Ihrem Team bilden dabei den Rahmen.' : 'You work directly with me. We agree on tasks, responsibilities and boundaries in advance, using your existing standards and team collaboration as the foundation.'}</p></div></div></section>
<section class="section experience-section"><div class="container"><p class="eyebrow">{de ? 'FACHLICHER HINTERGRUND' : 'PROFESSIONAL BACKGROUND'}</p><h2>{de ? 'Erfahrung, auf die Sie aufbauen können.' : 'Experience you can build on.'}</h2><dl class="experience-list">{facts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></div></section>
<ContactCta lang={lang} />
