---
import { services, routes, type Locale } from '../data/site';
import Arrow from './Arrow.astro';
import PageIntro from './PageIntro.astro';
import ContactCta from './ContactCta.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const de = lang === 'de';
---
<PageIntro eyebrow={de ? 'LEISTUNGEN' : 'SERVICES'} title={de ? 'Technische Unterstützung, die im Alltag ankommt.' : 'Engineering support that makes a practical difference.'} description={de ? 'PowerShell-Automatisierung, Windows- und Azure-Projekte: Wir grenzen die Aufgabe ab und stimmen Umsetzung, Tests und Übergabe auf Ihre Umgebung ab.' : 'PowerShell automation, Windows and Azure projects: we define the task and tailor implementation, testing and handover to your environment.'} />
<div class="container"><nav class="service-anchor-nav" aria-label={de ? 'Leistungsbereiche' : 'Service areas'}>{services[lang].map(s => <a href={`#${s.id}`}><span class="mono">{s.number}</span>{s.title}<span aria-hidden="true">↓</span></a>)}</nav></div>
{services[lang].map((s) => (
  <section class="service-detail section" id={s.id}>
    <div class="container detail-grid">
      <div>
        <p class="eyebrow">{de ? 'LEISTUNGSBEREICH' : 'SERVICE AREA'} <span class="mono">/ {s.number}</span></p>
        <h2>{s.title}</h2>
        <p class="lead">{s.summary}</p>
        <div class="tags">{s.tags.map(tag => <span>{tag}</span>)}</div>
      </div>
      <div class="service-detail-copy">
        <h3>{s.approachTitle}</h3>
        <p>{s.approach}</p>
        <h3>{s.handoverTitle}</h3>
        <p>{s.handover}</p>
        <div class="deliverables">
          <h3>{s.itemsTitle}</h3>
          {s.itemsNote && <p class="small">{s.itemsNote}</p>}
          <ul>{s.items.map(item => <li>{item}</li>)}</ul>
        </div>
        {s.id === 'automation' && <a class="text-link" href={routes[lang].powershell}>{de ? 'PowerShell-Automatisierung im Detail' : 'Explore PowerShell automation'}<Arrow /></a>}
        {s.id === 'security' && <p class="scope-note">{de ? 'Technische Prüfungen und Maßnahmen, keine akkreditierten Audits, Zertifizierungen oder pauschale Compliance-Bestätigung.' : 'Technical checks and remediation, not accredited audits, certification or a blanket confirmation of compliance.'}</p>}
      </div>
    </div>
  </section>
))}
<ContactCta lang={lang} />
