---
interface Props {
  compact?: boolean;
  variant?: 'light' | 'dark';
}
const { compact = false, variant = 'light' } = Astro.props;
---
<span class:list={['brand', { 'brand-compact': compact }]}>
  <img
    src={`/brand/logo-on-${variant}.svg`}
    width="800"
    height="220"
    alt="Nimbus IT"
  />
</span>
