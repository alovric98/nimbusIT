---
import { contactEmail, routes, type Locale } from '../data/site';
import PageIntro from './PageIntro.astro';
import Arrow from './Arrow.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const de = lang === 'de';
const prompts = de ? [
  ['Ihre Aufgabe', 'Was möchten Sie automatisieren oder technisch umsetzen?'],
  ['Ihre Umgebung', 'Welche Systeme, Plattformen und Rahmenbedingungen sind relevant?'],
  ['Ihr Ziel', 'Welches Ergebnis brauchen Sie und in welchem Zeitrahmen?'],
] : [
  ['Your task', 'What would you like to automate or implement?'],
  ['Your environment', 'Which systems, platforms and constraints are relevant?'],
  ['Your goal', 'What outcome do you need, and within what timeframe?'],
];
---
<PageIntro eyebrow={de ? 'KONTAKT' : 'CONTACT'} title={de ? 'Beginnen wir mit Ihrer Aufgabe.' : 'Let’s start with your task.'} description={de ? 'Ein wiederkehrender Prozess, ein anstehendes Deployment oder eine konkrete Frage zur Infrastruktur: Eine kurze Beschreibung ist der beste Ausgangspunkt.' : 'A recurring process, an upcoming deployment or a specific infrastructure question: a short description is the best starting point.'} />
<section class="section">
  <div class="container contact-grid">
    <div class="contact-details">
      <p class="eyebrow">{de ? 'DIREKTER KONTAKT' : 'DIRECT CONTACT'}</p>
      <h2>{de ? 'Schreiben Sie mir.' : 'Tell me about your project.'}</h2>
      <p>{de ? 'Sie suchen Unterstützung bei PowerShell-Automatisierung, Windows- oder Azure-Infrastruktur? Schreiben Sie mir eine kurze E-Mail mit Ihrer Aufgabe. Gemeinsam klären wir den Umfang und die nächsten Schritte.' : 'Looking for support with PowerShell automation, Windows or Azure infrastructure? Send me a short email outlining your task. We can then clarify the scope and next steps together.'}</p>
      <div class="contact-email">
        <span class="mono">{de ? 'GESCHÄFTLICHE E-MAIL' : 'BUSINESS EMAIL'}</span>
        <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
      </div>
      <p class="small muted">{de ? 'Der Link öffnet Ihr E-Mail-Programm.' : 'The link opens your email application.'}</p>
    </div>
    <div class="enquiry-guide">
      <p class="eyebrow">{de ? 'FÜR DAS ERSTE GESPRÄCH' : 'FOR THE FIRST CONVERSATION'}</p>
      <h2>{de ? 'Drei hilfreiche Ausgangspunkte.' : 'Three useful starting points.'}</h2>
      <ol>{prompts.map(([title, text], index) => <li><span class="mono">0{index + 1}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol>
      <p class="small muted">{de ? 'Eine grobe Einordnung genügt. Zugangsdaten oder vertrauliche Kundendaten gehören nicht in eine erste Anfrage.' : 'A broad outline is enough. Credentials and confidential customer data do not belong in an initial enquiry.'}</p>
      <a class="text-link" href={routes[lang].services}>{de ? 'Leistungen im Überblick' : 'Explore the services'}<Arrow /></a>
    </div>
  </div>
</section>
