---
import type { Locale } from '../data/site';
import PageIntro from './PageIntro.astro';
interface Props { lang: Locale; kind: 'imprint' | 'privacy' }
const { lang, kind } = Astro.props;
const de = lang === 'de';
const imprint = kind === 'imprint';
const items = imprint ? (de ? ['Vollständiger rechtlicher Name und Rechtsform', 'Ladungsfähige Geschäftsanschrift', 'Verifizierte geschäftliche Kontaktdaten', 'Register-, Steuer- und weitere Pflichtangaben, soweit anwendbar'] : ['Full legal name and legal form', 'Registered business address', 'Verified business contact details', 'Registration, tax and other required details, where applicable']) : (de ? ['Verantwortlicher und verifizierte Kontaktdaten', 'Hosting-Anbieter, Protokolldaten und Speicherdauer', 'Tatsächlich eingesetzte Kontakt- und Datenverarbeitungsdienste', 'Zwecke, Rechtsgrundlagen, Empfänger und Betroffenenrechte'] : ['Data controller and verified contact details', 'Hosting provider, log data and retention periods', 'Contact and data processing services actually used', 'Purposes, legal bases, recipients and data subject rights']);
---
<PageIntro eyebrow={de ? 'RECHTLICHE INFORMATIONEN · ENTWURF' : 'LEGAL INFORMATION · DRAFT'} title={imprint ? (de ? 'Impressum' : 'Imprint') : (de ? 'Datenschutz' : 'Privacy')} />
<section class="section legal-section"><div class="container legal-copy"><div class="draft-notice"><strong>{de ? 'Entwurf – nicht zur Veröffentlichung freigegeben.' : 'Draft – not approved for publication.'}</strong><p>{de ? 'Diese Seite ist ein ausdrücklich gekennzeichneter Platzhalter und noch keine vollständige rechtliche Information.' : 'This page is an explicitly marked placeholder and does not yet provide complete legal information.'}</p></div><h2>{de ? 'Was vor der Veröffentlichung ergänzt wird' : 'What needs to be added before publication'}</h2><p>{imprint ? (de ? 'Die tatsächlichen Unternehmensangaben müssen vom Betreiber bereitgestellt und geprüft werden.' : 'The actual business details must be supplied and reviewed by the operator.') : (de ? 'Die endgültigen Datenschutzhinweise müssen auf den tatsächlichen Betrieb der Website abgestimmt und geprüft werden.' : 'The final privacy information must reflect how the website actually operates and must be reviewed.')}</p><ul class="legal-list">{items.map(item => <li>{item}</li>)}</ul>{!imprint && <><h2>{de ? 'Technischer Stand dieser Vorschau' : 'Technical status of this preview'}</h2><p>{de ? 'Die aktuelle Implementierung enthält keine Analysewerkzeuge, Marketing-Tracker, extern eingebetteten Medien oder Kontaktformulare. Schriften werden über das Betriebssystem geladen. Die Website setzt selbst keine Cookies. Mögliche Protokolldaten des späteren Hosting-Anbieters sind vor der Veröffentlichung zu klären.' : 'The current implementation includes no analytics tools, marketing trackers, externally embedded media or contact forms. Fonts are provided by the operating system. The website itself sets no cookies. Any log data collected by a future hosting provider must be clarified before publication.'}</p></>}</div></section>
